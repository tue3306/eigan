PORT_SIM_DOCKER_END=12376
PORT_SIM_K8S_INS=16443
PORT_SIM_K8S_END=16444
PORT_SIM_TELNET_INS=12323
PORT_SIM_SMTP_INS=12525
PORT_SIM_SMTP_END=12526
PORT_SIM_ELASTIC_INS=19200
PORT_SIM_ELASTIC_END=19201
PORT_SIM_WINRM_INS=15985

# --- Servidor de banners (versoes antigas SO NO BANNER, sem codigo vulneravel) ---
PORT_BANNER_HTTP_APACHE=18999
PORT_BANNER_HTTP_NGINX=18998
PORT_BANNER_FTP_VSFTPD=12199
PORT_BANNER_FTP_PROFTPD=12198
