# EIGAN Lab - mapa de portas (fonte unica da verdade; shell-sourceable).
# Tudo escuta somente em 127.0.0.1. Convencao: <servico>_<modo>[_<variante>].
# Modos: INS = inseguro (EIGAN deve reportar) / END = endurecido (EIGAN NAO deve reportar).
LAB_HOST=127.0.0.1

# --- Web: nginx (real) ---
PORT_NGINX_INS_HTTP=18080
PORT_NGINX_INS_TLS_LEGADO=18443
PORT_NGINX_INS_TLS_EXPIRADO=18444
PORT_NGINX_INS_TLS_AUTOASSINADO=18445
PORT_NGINX_INS_TLS_HOSTERRADO=18446
PORT_NGINX_INS_SOFT404=18090
PORT_NGINX_END_HTTP=18081
PORT_NGINX_END_TLS=18447

# --- Web: Apache httpd (real, pacote Ubuntu extraido em espaco de usuario) ---
PORT_APACHE_INS_HTTP=18180
PORT_APACHE_INS_TLS=18543
PORT_APACHE_END_HTTP=18181
PORT_APACHE_END_TLS=18544

# --- Apache Tomcat (real, tarball oficial + JDK conda-forge) ---
PORT_TOMCAT_INS_HTTP=18088
PORT_TOMCAT_INS_AJP=18009
PORT_TOMCAT_INS_SHUTDOWN=18005
PORT_TOMCAT_END_HTTP=18089
PORT_TOMCAT_END_SHUTDOWN=18006

# --- Acesso remoto ---
PORT_SSHD_INS=12222
PORT_SSHD_END=12223

# --- Bancos e caches (reais) ---
PORT_REDIS_INS=16379
PORT_REDIS_END=16380
PORT_MEMCACHED_INS=21211
PORT_MEMCACHED_END=21212
PORT_POSTGRES_INS=15432
PORT_POSTGRES_END=15433
PORT_MYSQL_INS=13306
PORT_MYSQL_END=13307
PORT_MONGO_INS=27018
PORT_MONGO_END=27019
PORT_ETCD_INS_CLIENT=12379
PORT_ETCD_INS_PEER=12380
PORT_ETCD_END_CLIENT=12381
PORT_ETCD_END_PEER=12382

# --- Arquivos ---
PORT_FTP_INS=12121
PORT_FTP_END=12122
PORT_SMB_INS=14445
PORT_SMB_END=14446

# --- DNS (BIND9 real; UDP e TCP) ---
PORT_DNS_INS=15353
PORT_DNS_END=15354

# --- Extras reais ---
PORT_MQTT_INS=11883
PORT_MQTT_END=11884

# --- Simuladores (Python, protocolo reduzido; ver simuladores/README) ---
PORT_SIM_RDP_INS=13389
PORT_SIM_RDP_END=13390
PORT_SIM_MSSQL_INS=11433
PORT_SIM_MSSQL_END=11434
PORT_SIM_VNC_INS=15900
PORT_SIM_VNC_END=15901
